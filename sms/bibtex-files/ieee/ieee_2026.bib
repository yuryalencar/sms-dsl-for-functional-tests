  booktitle={42nd International Communications Satellite Systems Conference (ICSSC 2025)}, 
  title={Monitoring systems for nanosatellite constellations: towards end-to-end supervision}, 
  year={2025},
  volume={2025},
  number={},
  pages={176-183},
  abstract={NewSpace trends are fostering the growth of large-scale nanosatellite constellations in LEO by leveraging commercial-off-the-shelf (COTS) components to create cost-effective, advanced platforms. Payloads have also benefited, evolving into low-cost, high-performance platforms, with in flight hardware reconfiguration capabilities. These systems behave as distributed infrastructures where Network Function Virtualization (NFV) and Management and Orchestration (MANO) enable on-demand and automatic service deployment. The management of such complex, scalable and service-oriented constellations lead to a growing need to efficiently monitor nodes and services in operation. This work introduces LEOMON, a six-layer framework that links local payload telemetry (FPGA SoC) with constellation-wide monitoring. A representative implementation demonstrates per-layer instrumentation and unifies telemetry into a central time-series hub, aggregating more than 28,000 metrics. With end-to-end visibility, monitoring shifts from a fragmented utility to an operational backbone with capacity to enhance service deployment and improve resilience through cross-layer time-series data analysis that can reveal error patterns.},
  keywords={},
  doi={10.1049/icp.2025.4062},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11411211,
  author={Shinde, Om and Salunke, Dipmala and Nipunge, Akash and Patil, Darshan and Kadam, Mahesh B. and Nikat, Swapnil and Tekade, Pallavi},
  booktitle={2025 2nd Asia Pacific Conference on Innovation in Technology (APCIT)}, 
  title={Efficient Software Development with UML-Based Code Generation}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Software development is often complex and time-consuming, requiring meticulous planning, design, and coding. Unified Modeling Language (UML) diagrams are widely used in software engineering to visually represent system architectures and workflows, aiding developers in understanding system functionality and requirements. However, manually translating UML diagrams into code remains a labor-intensive task, which can lead to inconsistencies and errors. This paper presents an innovative approach for automating code generation directly from UML diagrams, aiming to streamline the development process and enhance productivity. Our proposed tool parses UML diagrams, interprets object-oriented design elements, and generates executable code in the specified programming language. By integrating this tool into the software development lifecycle, developers can achieve significant time savings and reduce potential errors associated with manual coding. Our methodology, which combines UML parsing with automated code synthesis, demonstrates promising results in increasing development efficiency and maintaining code consistency. The tool’s application in real-world scenarios highlights its potential to support agile development practices and provide a scalable solution for complex projects. Future work includes expanding compatibility with additional programming languages and refining code optimization capabilities to further improve usability and effectiveness.},
  keywords={Productivity;Computer languages;Codes;Translation;Unified modeling language;Manuals;Encoding;Natural language processing;Usability;Software engineering;Unified Modeling Language (UML);Software Development Life Cycle (SDLC);Machine Learning (ML);Natural Language Processing (NLP);Model-Driven Development;Requirements Engineering;Object-Oriented Design;Code Generation;Development Efficiency;Prototyping;Use Case Diagrams},
