  booktitle={2025 6th International Symposium on Computer Engineering and Intelligent Communications (ISCEIC)}, 
  title={A Scalable Backend Data Processing System for Large-Scale Social Media Analytics: Multi-Threaded NLP and Sentiment Analysis Pipeline Implementation}, 
  year={2025},
  volume={},
  number={},
  pages={605-611},
  abstract={This paper presents a scalable backend system for large-scale social media analytics, focusing on natural language processing and sentiment analysis for Australian discourse. The framework addresses heterogeneous data challenges through multi-threaded producer–consumer architectures, hybrid sentiment models, and multi-scenario analysis.Core contributions include: (1) a multi-threaded formatter for efficient cross-platform standardization; (2) a hybrid sentiment analysis framework integrating VADER and TextBlob with Australian lexicon customization for aspect-based sentiment detection; (3) a multi-scenario analyzer enabling concurrent studies on AI Regulation, Skilled Immigration, and Digital Transformation; and (4) comprehensive trend detection with statistical significance testing. Additional NLP functions—location extraction, discussion-type classification, and trend correlation—support nuanced cross-platform analysis.Experimental evaluation on 67.98GB of Reddit and distributed social media data reduced to 6.43GB of high-quality output (9.5% retention rate), confirming both efficiency and analytical precision across three research scenarios with robust fault tolerance and scalability mechanisms.},
  keywords={Sentiment analysis;Fault tolerance;Social networking (online);Fault tolerant systems;Process control;Standardization;Lexicon;Market research;Regulation;Testing;social media analytics;natural language processing;sentiment analysis;multi-threaded processing;big data;cloud computing},
